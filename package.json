{
  "name": "cifrai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "dev": "echo 'dev: placeholder (web em F0-07, api em F0-06)' && exit 0",
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bash infra/scripts/validate.sh",
    "content:validate": "pnpm --filter @cifrai/content validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.3.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.7"
  }
}
