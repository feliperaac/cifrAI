# Copie para .env (nunca commitar). Apenas nomes/valores de exemplo.
NODE_ENV=development
API_PORT=3000
ORACLE_HOST=host.docker.internal
ORACLE_PORT=1521
ORACLE_SERVICE=CHANGE_ME_PDB_SERVICE
ORACLE_USER=CIFRAI_APP
ORACLE_PASSWORD=CHANGE_ME
# Segredo do HMAC dos tokens de sessao (ADR-0004), minimo 32 caracteres. Gerar: openssl rand -base64 48
# A API recusa valores que comecem com CHANGE_ME. Trocar invalida todas as sessoes.
SESSION_SECRET=CHANGE_ME_gerar_com_openssl_rand_base64_48
# Origens extras (separadas por virgula) aceitas na checagem anti-CSRF, alem da propria origem.
# Vazio no navegador/PWA; no APK Capacitor: https://localhost (ver ADR-0004).
APP_ORIGINS=
# Usuario de DDL, usado so pelo Flyway (servico `migrate`). O compose exige estas variaveis
# ate para `build`, entao elas precisam existir (no CI, com os valores dummy deste arquivo).
ORACLE_MIG_USER=CIFRAI_MIG
ORACLE_MIG_PASSWORD=CHANGE_ME

# Docker/Compose
IMAGE_TAG=local
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
API_DEV_PORT=3000
WEB_DEV_PORT=5173
