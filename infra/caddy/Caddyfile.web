# Servidor estatico interno do servico web (prod). Apenas o proxy publica portas.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	@health path /health
	respond @health 200

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@nocache path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
